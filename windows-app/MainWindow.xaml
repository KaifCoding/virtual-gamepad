<Window x:Class="VirtualGamepadHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Virtual Gamepad Host"
        Height="640" Width="760"
        MinHeight="480" MinWidth="620"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="#E7E2DE"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#C9C2BC" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#AEE4F0" Offset="0"/>
                        <GradientStop Color="#7FB8D6" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#0B5FA3" VerticalAlignment="Center">
                        <TextBlock Text="&#127918;" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="Virtual Gamepad" FontSize="19" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="FREE FOREVER · WIFI CONTROLLER" FontSize="10.5" FontStyle="Italic"
                                   FontWeight="SemiBold" Foreground="#374151"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="&#8212;" Style="{StaticResource TitleBarButton}" Background="#57D6F2"
                                Click="Minimize_Click" ToolTip="Minimize"/>
                        <Button Content="&#9723;" Style="{StaticResource TitleBarButton}" Background="#57D6F2"
                                Click="MaximizeRestore_Click" ToolTip="Maximize"/>
                        <Button Content="&#10005;" Style="{StaticResource TitleBarButton}" Background="#EF4444"
                                Foreground="White" Click="Close_Click" ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Body -->
            <Grid Grid.Row="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">

                    <TextBlock Text="========================================" HorizontalAlignment="Center"
                               Foreground="#9CA3AF" FontFamily="Consolas" FontSize="13" Margin="0,0,0,4"/>
                    <TextBlock Text="Virtual Gamepad Host" HorizontalAlignment="Center" FontSize="22"
                               FontWeight="Bold" Foreground="#111827" Margin="0,4"/>
                    <TextBlock Text="========================================" HorizontalAlignment="Center"
                               Foreground="#9CA3AF" FontFamily="Consolas" FontSize="13" Margin="0,4,0,24"/>

                    <TextBlock Text="Enter one of these addresses in the phone app (WiFi must be on the same network):"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="#374151" FontSize="13.5" Margin="0,0,0,10"/>

                    <TextBlock x:Name="AddressText" Text="Detecting local IP address..." HorizontalAlignment="Center"
                               FontWeight="Bold" FontSize="17" Foreground="#111827" Margin="0,0,0,18"/>

                    <TextBlock Text="Or just tap &quot;Auto-discover&quot; in the app - it will find this PC automatically"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="#6B7280" FontStyle="Italic" FontSize="12.5" Margin="0,0,0,22"/>

                    <Border Background="White" CornerRadius="12" Padding="20,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="ConnectedCountText" Text="Connected Device : 0" HorizontalAlignment="Center"
                                       FontWeight="Bold" FontSize="16" Foreground="#111827"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer x:Name="LogScroll" Height="150" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed">
                        <ItemsControl x:Name="LogList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11.5"
                                               Foreground="#4B5563" Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button x:Name="ToggleLogButton" Content="Show connection log" HorizontalAlignment="Center"
                            Margin="0,16,0,0" Click="ToggleLog_Click" Background="Transparent" BorderThickness="0"
                            Foreground="#0B5FA3" Cursor="Hand" FontSize="12"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="#6B7280">
                        <Run Text="Created With "/>
                        <Run Text="&#9829;" Foreground="#DC2626"/>
                        <Run Text=" by "/>
                        <Hyperlink NavigateUri="https://github.com/kaifcoding" RequestNavigate="Hyperlink_RequestNavigate">kaifcoding</Hyperlink>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="#6B7280" Margin="0,2,0,0">
                        <Run Text="© 2026 Atomprod. All rights reserved."/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
